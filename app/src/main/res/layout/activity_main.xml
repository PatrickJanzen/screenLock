<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Local Screen Lock Controller"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <RadioGroup
        android:id="@+id/modeRadioGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <RadioButton
            android:id="@+id/radioLockMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lock Mode (Target)"
            android:checked="true"
            android:paddingEnd="16dp" />

        <RadioButton
            android:id="@+id/radioTriggerMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Trigger Mode (Controller)" />
    </RadioGroup>

    <!-- Lock Mode UI -->
    <LinearLayout
        android:id="@+id/lockModeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This device will listen for lock commands."
            android:textSize="14sp"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enable Accessibility Service"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/ipTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IP Address: Loading..."
            android:textSize="16sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Trigger Mode UI -->
    <LinearLayout
        android:id="@+id/triggerModeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan and lock target devices on this network."
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/scanButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scan for Devices"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discovered Devices:"
            android:textStyle="bold"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp" />

        <ListView
            android:id="@+id/devicesListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/lockSelectedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lock Selected Device"
            android:enabled="false" />
    </LinearLayout>

</LinearLayout>
